# Server connection and initial administrator settings
DATABASE_URL=postgres://user:password@host:5432/nexora
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Nexora Administrator

# Optional live reasoning; navigation and saved-data answers work without these.
# Choose one provider: openrouter or openai.
AI_PROVIDER=openrouter
AI_MODEL=
# Set only the key for the selected provider; keep secrets in the server environment.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional OpenRouter attribution URL
APP_URL=
